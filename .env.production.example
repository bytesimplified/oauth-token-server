# COPY to .env.production, customize and DO NOT commit.
# DNS must point OAUTH_DOMAIN at the HTTPS ingress host.
OAUTH_DOMAIN=oauth.example.com
OAUTH_ENV=production
OAUTH_ISSUER=https://oauth.example.com
OAUTH_AUDIENCE=orders-api
OAUTH_ALLOWED_SCOPES=orders:read orders:write
OAUTH_TOKEN_TTL_SECONDS=600
OAUTH_RATE_LIMIT_PER_MINUTE=30
OAUTH_ADMIN_UI_ENABLED=false

# AWS role permissions: kms:Sign/GetPublicKey, secretsmanager:GetSecretValue
AWS_DEFAULT_REGION=us-east-1
OAUTH_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/REPLACE
OAUTH_KMS_VERIFY_KEY_IDS=
OAUTH_AWS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:REPLACE

# OIDC administrator identity provider (issuer/audience/JWKS must match)
OAUTH_ADMIN_OIDC_ISSUER=https://login.example.com
OAUTH_ADMIN_OIDC_AUDIENCE=oauth-admin
OAUTH_ADMIN_OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
OAUTH_ADMIN_ROLE_CLAIM=roles
