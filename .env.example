# Local development
OAUTH_ISSUER=http://127.0.0.1:8000
OAUTH_AUDIENCE=orders-api
OAUTH_DB_URL=sqlite:///./oauth.db
OAUTH_PRIVATE_KEY_PATH=./keys/private.pem
OAUTH_TOKEN_TTL_SECONDS=600
OAUTH_ALLOWED_SCOPES=orders:read orders:write
OAUTH_ADMIN_API_KEY=replace-with-32-or-more-random-characters
OAUTH_ADMIN_UI_ENABLED=false
OAUTH_RATE_LIMIT_PER_MINUTE=30
OAUTH_REDIS_URL=
OAUTH_METRICS_KEY=replace-with-a-strong-secret
OAUTH_ENV=development

# Production (requires external HTTPS ingress, managed PostgreSQL/Redis, OIDC admin IdP)
# OAUTH_ENV=production
# OAUTH_ISSUER=https://oauth.example.com
# OAUTH_ADMIN_OIDC_ISSUER=https://idp.example.com
# OAUTH_ADMIN_OIDC_AUDIENCE=oauth-admin
# OAUTH_ADMIN_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# OAUTH_ADMIN_ROLE_CLAIM=roles

# Docker Compose
POSTGRES_PASSWORD=replace-with-strong-database-password
